# ==========================================
# 1. PYTHON & UTVECKLING
# ==========================================
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
.venv/
pip-log.txt
pip-delete-this-directory.txt
.env
.pytest_cache/

# ==========================================
# 2. REAPER (DAW)
# ==========================================
*.RPP-bak
*.reapeaks
*.RPP-UNDO
*upload*
# Spara själva .RPP-filen (mallen), men inte lokala inspelningsfiler om de hamnar i samma mapp:
# *.wav 

# ==========================================
# 3. WWISE (MIDDLEWARE)
# ==========================================
# Ignorera lokala cache- och backup-filer som Wwise återskapar automatiskt
.backup*/
.cache*/
*.akd
*.prof
*.validationcache
*.wsettings
IncrementalSoundBankData.xml

# Genererade SoundBanks (bör genereras lokalt av användaren/skriptet)
GeneratedSoundBanks/

# ==========================================
# 4. AUDIO PIPELINE PIPELINE (PROJEKTSPECIFIKT)
# ==========================================
# Ignorera de renderade ljudfilerna som ditt skript spottar ur sig. 
# Vi vill inte ladda upp gigabyte med prov-dialog.
renders/
audio_out/
audio_in/
*.wav
*.mp3

# Men vi tillåter ett par exempel-filer om du absolut vill ha dem i en test-mapp:
!tests/assets/*.wav

# ==========================================
# 5. IDE & SYSTEM (VS Code, Windows, Mac)
# ==========================================
.vscode/
!.vscode/launch.json
!.vscode/tasks.json
.DS_Store
Thumbs.db
